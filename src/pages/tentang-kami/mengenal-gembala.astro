---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Mengenal Gembala">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-navy-950 mb-8">Mengenal Gembala</h1>

    <div class="bg-white rounded-2xl border border-cream-200 p-6 sm:p-8 flex flex-col sm:flex-row gap-6 items-start">
      <div class="w-24 h-24 rounded-full bg-cream-100 flex items-center justify-center flex-shrink-0 mx-auto sm:mx-0">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0f1f3d" stroke-width="1.5"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
      </div>
      <div class="text-center sm:text-left">
        <h2 class="font-serif text-xl font-semibold text-navy-950">Pdt. Ubang Laing, M.A</h2>
        <p class="text-gold-600 text-sm font-medium mb-3">Gembala Sidang / Ketua Badan Pengurus Jemaat</p>
        <p class="text-navy-800/50 italic text-sm">
          Foto dan riwayat pelayanan lengkap akan ditambahkan di sini.
        </p>
      </div>
    </div>
  </div>
</Layout>
