---
import Layout from "../../layouts/Layout.astro";
import { NAMA_GEREJA } from "../../lib/config.js";
---

<Layout title="Visi, Misi & Value">
  <div class="max-w-4xl mx-auto px-4 py-10 space-y-6">
    <h1 class="font-serif text-3xl font-semibold text-navy-950">Visi, Misi &amp; Value</h1>

    <section class="bg-white rounded-2xl border border-cream-200 p-6 sm:p-8">
      <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-3">Visi</p>
      <p class="text-navy-900 leading-relaxed">
        {NAMA_GEREJA} ada untuk menjadi serupa dengan Kristus serta memuliakan Allah dalam
        seluruh aspek kehidupannya dan menjadi gereja yang missioner, serta siap menyambut
        kedatangan Kristus.
      </p>
    </section>

    <section class="bg-white rounded-2xl border border-cream-200 p-6 sm:p-8">
      <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-3">Misi</p>
      <p class="text-navy-900 mb-3">GKII Jemaat "Talitha Koum Sendawar" menerima tanggung jawab untuk:</p>
      <ul class="space-y-2 text-navy-900">
        <li class="flex gap-2"><span class="text-gold-600 flex-shrink-0">&#9679;</span> Aktif <strong>beribadah</strong> kepada Tuhan dalam kehidupan sehari-hari</li>
        <li class="flex gap-2"><span class="text-gold-600 flex-shrink-0">&#9679;</span> Memelihara hubungan dengan Tuhan dan sesama melalui <strong>persekutuan</strong> sebagai bukti kedewasaan iman</li>
        <li class="flex gap-2"><span class="text-gold-600 flex-shrink-0">&#9679;</span> Bersedia <strong>dimuridkan</strong> serta bertanggung jawab memuridkan orang percaya lainnya untuk lebih mengenal Kristus</li>
        <li class="flex gap-2"><span class="text-gold-600 flex-shrink-0">&#9679;</span> Terlibat aktif dalam <strong>pemberitaan Injil</strong> Kristus</li>
        <li class="flex gap-2"><span class="text-gold-600 flex-shrink-0">&#9679;</span> Menjadi <strong>gereja pengutus</strong></li>
      </ul>
    </section>

    <section class="bg-navy-950 text-cream-50 rounded-2xl p-6 sm:p-8 text-center">
      <p class="text-xs font-semibold tracking-wide text-gold-400 uppercase mb-2">Moto</p>
      <p class="font-serif text-xl sm:text-2xl">Hidup Berarti Bekerja Memberi Buah</p>
      <p class="text-cream-100/70 text-sm mt-1">Filipi 1:22</p>
    </section>

    <section class="bg-white rounded-2xl border border-dashed border-cream-200 p-6 sm:p-8">
      <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-3">Value / Nilai-Nilai Inti</p>
      <p class="text-navy-800/50 italic text-sm">
        Rumusan nilai-nilai inti (values) gereja secara spesifik akan ditambahkan di sini.
        Silakan sampaikan rumusannya kapan saja.
      </p>
    </section>

    <section class="bg-white rounded-2xl border border-cream-200 p-6 sm:p-8">
      <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-3">Legalitas</p>
      <dl class="text-sm text-navy-900 space-y-1.5">
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="text-navy-800/60 sm:w-56 flex-shrink-0">Nama Badan Hukum</dt>
          <dd>Gereja Kemah Injil Indonesia</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="text-navy-800/60 sm:w-56 flex-shrink-0">Terdaftar di Departemen Agama RI</dt>
          <dd>Nomor 87 Tahun 1987</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="text-navy-800/60 sm:w-56 flex-shrink-0">Akte Notaris</dt>
          <dd>Nomor 14, Tanggal 11 Juli 1984</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="text-navy-800/60 sm:w-56 flex-shrink-0">Berita Negara RI</dt>
          <dd>Nomor 105, Tanggal 31 Desember 1993</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="text-navy-800/60 sm:w-56 flex-shrink-0">Keanggotaan</dt>
          <dd>Anggota PGI Ke-85</dd>
        </div>
      </dl>
    </section>
  </div>
</Layout>
